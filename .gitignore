!data/processed/crop_normalization_map.csv
!data/processed/label_map.json
!data/processed/label_exclusions.csv
!data/processed/splits_meta.json
!data/processed/class_block_counts.csv
!data/processed/features/
data/processed/features/*
!data/processed/features/features_lightgbm.parquet
!data/processed/features/feature_meta.parquet
!data/processed/perennial/
data/processed/perennial/*
!data/processed/perennial/*.parquet
!data/processed/perennial/*.csv
!data/processed/perennial/*.json

# ── the national extension: parcels, Landsat features, tenure, evaluation record ─────
!data/processed/all_peru/
data/processed/all_peru/*
!data/processed/all_peru/modeling_parcels.parquet
!data/processed/all_peru/tenure_by_predio.parquet
!data/processed/all_peru/tenure_two_period.parquet
!data/processed/all_peru/panel_parcels.parquet
!data/processed/all_peru/panel_predictions*.parquet
# the LODO / LOYO / LODYO metrics and summaries — small, and hours to recompute
!data/processed/all_peru/*.csv
!data/processed/all_peru/*.json
!data/processed/all_peru/features/
data/processed/all_peru/features/*
!data/processed/all_peru/features/features_lightgbm.parquet
!data/processed/all_peru/features/features_lightgbm_degraded.parquet
!data/processed/all_peru/features/feature_meta.parquet

# ── the Sentinel-2 store and the photo-interpreted label set ─────────────────────────
