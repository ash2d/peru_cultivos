# Python-generated files
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Run logs from long background jobs (panel extract/assemble)
logs/

# Model run outputs (782 MB of parquet/boosters). The two selection records that
# docs cite by path are force-added: `git add -f runs/all_peru/selected_model*.json`.
runs/

# LaTeX build products. `reports/peru_report.tex` and its PDF are tracked; everything
# latexmk drops beside them is not.
reports/*.aux
reports/*.fdb_latexmk
reports/*.fls
reports/*.log
reports/*.out
reports/*.synctex.gz
reports/*.toc
reports/*.bbl
reports/*.blg

# Data & credentials
data/
# ...except the synthetic demo workspace, which is committed so that a fresh clone runs
# something. It is generated by tools/make_demo_workspace.py and is ~900 KB.
!data/demo/
!data/demo/**
*.tif
*.tiff
.env
*-key.json
credentials.json
